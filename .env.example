# Public, read-only values. Safe to expose: they only allow reading PUBLISHED content.
# Never put a Sanity write token in this file or anywhere in the frontend.
VITE_SANITY_PROJECT_ID=your_project_id
VITE_SANITY_DATASET=production
# Address of your hosted Studio (the admin panel), e.g. https://drazynth-vault.sanity.studio
VITE_STUDIO_URL=https://your-studio-name.sanity.studio
# Copyright / takedown contact shown on Privacy and Terms pages
VITE_CONTACT_EMAIL=you@example.com
